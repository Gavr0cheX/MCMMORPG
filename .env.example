NODE_ENV=development
PUBLIC_BASE_URL=http://localhost
API_BASE_URL=http://localhost/api
FRONTEND_BASE_URL=http://localhost
LAUNCHER_UPDATES_BASE_URL=http://localhost/launcher-updates

POSTGRES_DB=mmorpg
POSTGRES_USER=mmorpg
POSTGRES_PASSWORD=change_me_dev
DATABASE_URL=postgresql://mmorpg:change_me_dev@postgres:5432/mmorpg?schema=public

REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace_with_64_chars_minimum_access_secret
JWT_REFRESH_SECRET=replace_with_64_chars_minimum_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace_with_32_chars_minimum_cookie_secret
INTERNAL_API_TOKEN=replace_with_internal_service_token

VELOCITY_FORWARDING_SECRET=replace_with_velocity_forwarding_secret
MINECRAFT_VERSION=1.21.8
PAPER_TYPE=PURPUR
MINECRAFT_INIT_MEMORY=256M
MINECRAFT_MAX_MEMORY=1G
MINECRAFT_SERVER_HOST=localhost
MINECRAFT_SERVER_PORT=25565
MINECRAFT_SESSION_HOST_SUFFIX=127.0.0.1.sslip.io
MINECRAFT_JAVA_PATH=
MINECRAFT_LAUNCH_EXECUTABLE=
MINECRAFT_LAUNCH_ARGS={connectionArgs}

CORS_ORIGINS=http://localhost,http://localhost:3001
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin
